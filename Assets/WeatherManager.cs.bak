using System.Collections;
using UnityEngine;
using UnityEngine.Networking;
using TMPro;
using UnityEngine.UI;

[System.Serializable]
public class WeatherData
{
    public string name;
    public MainData main;
    public WindData wind;
    public WeatherInfo[] weather;
}

[System.Serializable]
public class MainData
{
    public float temp;
    public float humidity;
}

[System.Serializable]
public class WindData
{
    public float speed;
}

[System.Serializable]
public class WeatherInfo
{
    public string main;
    public string description;
}

public class WeatherManager : MonoBehaviour
{
    [Header("Weather API")]
    [Tooltip("OpenWeatherMap API Key")]
    public string apiKey = "83df4a5aa9321e9d9195217241115f21";
    public float refreshInterval = 60f;

    [Header("City Search UI")]
    public TMP_InputField cityInput;
    public Button searchButton;
    public TextMeshProUGUI weatherText;
    public GameObject weatherPanel;

    [Header("3D Environment")]
    public GameObject sunObject;
    public Light sunlight;
    public WindZone engineWindZone;
    public ParticleSystem rainParticles;

    public static WeatherManager Instance { get; private set; }

    [Header("Telemetry State")]
    public string CurrentCondition { get; private set; } = "Clear";
    public float CurrentWindSpeed { get; private set; } = 1.0f;
    public float CurrentTemperature { get; private set; } = 20.0f;
    public float CurrentHumidity { get; private set; } = 50.0f;
    public bool IsRaining { get; private set; } = false;
    public bool IsThunderstorm { get; private set; } = false;
    public event System.Action<WeatherData> OnWeatherUpdated;

    private string selectedCity = "";
    private Coroutine requestCoroutine;
    private Coroutine refreshCoroutine;
    private bool isSearching;

    private void Awake()
    {
        // If this component is on "Rain" while "Weather System" exists, disable duplicate
        if (gameObject.name == "Rain")
        {
            WeatherManager[] managers = Object.FindObjectsByType<WeatherManager>(FindObjectsSortMode.None);
            foreach (var m in managers)
            {
                if (m != this && m.gameObject.name == "Weather System")
                {
                    Debug.LogWarning("Disabling duplicate WeatherManager component on Rain GameObject.");
                    enabled = false;
                    return;
                }
            }
        }

        // Auto-link references if unassigned in scene
        if (cityInput == null)
            cityInput = Object.FindFirstObjectByType<TMP_InputField>();

        if (searchButton == null)
            searchButton = Object.FindFirstObjectByType<Button>();

        if (weatherPanel == null)
        {
            GameObject wp = GameObject.Find("WeatherReportPanel");
            if (wp != null)
                weatherPanel = wp;
        }

        if (weatherText == null && weatherPanel != null)
        {
            weatherText = weatherPanel.GetComponentInChildren<TextMeshProUGUI>(true);
        }

        if (Instance == null || !Instance.enabled)
        {
            Instance = this;
        }
    }

    void Start()
    {
        // Support setting API key via environment variable to keep secrets out of source control
        string envKey = System.Environment.GetEnvironmentVariable("OPENWEATHER_API_KEY");
        if (!string.IsNullOrEmpty(envKey))
        {
            apiKey = envKey.Trim();
        }

        selectedCity = "";

        if (cityInput != null)
        {
            cityInput.interactable = true;
            cityInput.text = "";
            cityInput.onSubmit.RemoveListener(OnInputSubmit);
            cityInput.onSubmit.AddListener(OnInputSubmit);
            cityInput.onEndEdit.RemoveListener(OnInputEndEdit);
            cityInput.onEndEdit.AddListener(OnInputEndEdit);
        }

        if (weatherPanel != null)
        {
            weatherPanel.SetActive(false);
        }

        if (weatherText != null)
        {
            weatherText.text = "";
            weatherText.gameObject.SetActive(true);
        }

        if (rainParticles != null)
        {
            var emission = rainParticles.emission;
            emission.enabled = false;
            rainParticles.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
            rainParticles.Clear(true);
        }

        if (searchButton != null)
        {
            searchButton.interactable = true;
            searchButton.onClick.RemoveListener(SearchCity);
            searchButton.onClick.AddListener(SearchCity);
        }

        // Apply clean initial clear environment
        ApplyClearEnvironment();

        // No default city, API request, or rain at startup.
    }

    private void OnInputSubmit(string text)
    {
        SearchCity();
    }

    private void OnInputEndEdit(string text)
    {
        if (Input.GetKeyDown(KeyCode.Return) || Input.GetKeyDown(KeyCode.KeypadEnter))
        {
            SearchCity();
        }
    }

    public void SearchCity()
    {
        if (isSearching)
            return;

        if (cityInput == null)
        {
            ShowMessage("City input is not connected.");
            return;
        }

        string city = cityInput.text.Trim();

        if (string.IsNullOrWhiteSpace(city))
        {
            ShowMessage("Please enter a city name.");
            return;
        }

        if (string.IsNullOrWhiteSpace(apiKey))
        {
            ShowMessage("API key is missing.");
            return;
        }

        selectedCity = city;

        if (requestCoroutine != null)
            StopCoroutine(requestCoroutine);

        requestCoroutine = StartCoroutine(GetWeather(city, false));

        if (refreshCoroutine == null)
            refreshCoroutine = StartCoroutine(RefreshWeatherLoop());
    }

    IEnumerator RefreshWeatherLoop()
    {
        while (true)
        {
            yield return new WaitForSeconds(Mathf.Max(10f, refreshInterval));

            if (!string.IsNullOrWhiteSpace(selectedCity) && !isSearching)
            {
                if (requestCoroutine != null)
                    StopCoroutine(requestCoroutine);

                requestCoroutine = StartCoroutine(GetWeather(selectedCity, true));
            }
        }
    }

    IEnumerator GetWeather(string city, bool isAutoRefresh)
    {
        isSearching = true;

        if (!isAutoRefresh)
            ShowMessage("Fetching weather for " + city + "...");

        string url =
            "https://api.openweathermap.org/data/2.5/weather?q=" +
            UnityWebRequest.EscapeURL(city) +
            "&appid=" + UnityWebRequest.EscapeURL(apiKey) +
            "&units=metric";

        using (UnityWebRequest request = UnityWebRequest.Get(url))
        {
            request.timeout = 15;
            yield return request.SendWebRequest();

            if (request.result != UnityWebRequest.Result.Success)
            {
                // Mask API key in error log
                Debug.LogError(
                    "Weather API error code: " + request.responseCode + " | Status: " + request.error
                );

                if (!isAutoRefresh)
                {
                    ShowMessage(
                        "Could not get weather for '" + city + "'.\nCheck the city name or internet connection."
                    );
                }

                isSearching = false;
                requestCoroutine = null;
                yield break;
            }

            WeatherData data = null;
            try
            {
                data = JsonUtility.FromJson<WeatherData>(request.downloadHandler.text);
            }
            catch (System.Exception ex)
            {
                Debug.LogError("Failed to parse weather data: " + ex.Message);
            }

            if (data == null || data.main == null || data.wind == null ||
                data.weather == null || data.weather.Length == 0)
            {
                if (!isAutoRefresh)
                    ShowMessage("Invalid weather data received for '" + city + "'.");

                isSearching = false;
                requestCoroutine = null;
                yield break;
            }

            ApplyWeather(data);
        }

        isSearching = false;
        requestCoroutine = null;
    }

    void ApplyClearEnvironment()
    {
        CurrentCondition = "Clear";
        IsRaining = false;
        IsThunderstorm = false;
        CurrentWindSpeed = 1.0f;

        if (sunObject != null)
            sunObject.SetActive(true);

        if (sunlight != null)
        {
            sunlight.intensity = 1.6f;
            sunlight.color = new Color(1.0f, 0.96f, 0.88f);
        }

        RenderSettings.fog = false;
        RenderSettings.ambientLight = new Color(0.80f, 0.85f, 0.90f);
    }

    void ApplyWeather(WeatherData data)
    {
        string condition = data.weather[0].main;
        string description = data.weather[0].description;
        string actualCity = string.IsNullOrEmpty(data.name) ? selectedCity : data.name;

        CurrentCondition = condition;
        CurrentWindSpeed = data.wind != null ? data.wind.speed : 1f;
        CurrentTemperature = data.main != null ? data.main.temp : 20f;
        CurrentHumidity = data.main != null ? data.main.humidity : 50f;

        // Capitalize description nicely
        if (!string.IsNullOrEmpty(description) && description.Length > 1)
        {
            description = char.ToUpper(description[0]) + description.Substring(1);
        }

        if (weatherPanel != null)
            weatherPanel.SetActive(true);

        if (weatherText != null)
        {
            weatherText.gameObject.SetActive(true);
            weatherText.text =
                "<b>LIVE WEATHER</b>\n" +
                "<b>City:</b> " + actualCity + "\n" +
                "<b>Condition:</b> " + description + " (" + condition + ")\n" +
                "<b>Temperature:</b> " + data.main.temp.ToString("F1") + " °C\n" +
                "<b>Wind:</b> " + data.wind.speed.ToString("F1") + " m/s\n" +
                "<b>Humidity:</b> " + data.main.humidity.ToString("F0") + "%";
        }

        bool raining =
            condition == "Rain" ||
            condition == "Drizzle" ||
            condition == "Thunderstorm";

        bool cloudy = condition == "Clouds";
        bool mistOrFog = condition == "Mist" || condition == "Fog" || condition == "Haze";

        if (rainParticles != null)
        {
            var emission = rainParticles.emission;
            emission.enabled = raining;

            if (raining)
            {
                if (!rainParticles.isPlaying)
                    rainParticles.Play();
            }
            else
            {
                rainParticles.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
                rainParticles.Clear(true);
            }
        }

        if (sunObject != null)
            sunObject.SetActive(condition == "Clear");

        if (sunlight != null)
        {
            if (condition == "Clear")
            {
                sunlight.intensity = 1.6f;
                sunlight.color = new Color(1.0f, 0.96f, 0.88f);
            }
            else if (cloudy)
            {
                sunlight.intensity = 0.65f;
                sunlight.color = new Color(0.85f, 0.88f, 0.95f);
            }
            else if (raining)
            {
                sunlight.intensity = 0.35f;
                sunlight.color = new Color(0.65f, 0.70f, 0.82f);
            }
            else
            {
                sunlight.intensity = 0.5f;
                sunlight.color = new Color(0.80f, 0.82f, 0.88f);
            }
        }

        if (engineWindZone != null)
        {
            engineWindZone.windMain = Mathf.Clamp(data.wind.speed * 0.25f, 0.2f, 5f);
        }

        if (condition == "Clear")
        {
            RenderSettings.fog = false;
            RenderSettings.ambientLight = new Color(0.80f, 0.85f, 0.90f);
        }
        else if (cloudy)
        {
            RenderSettings.fog = true;
            RenderSettings.fogMode = FogMode.ExponentialSquared;
            RenderSettings.fogDensity = 0.005f;
            RenderSettings.fogColor = new Color(0.72f, 0.75f, 0.82f);
            RenderSettings.ambientLight = new Color(0.62f, 0.65f, 0.72f);
        }
        else if (raining)
        {
            RenderSettings.fog = true;
            RenderSettings.fogMode = FogMode.ExponentialSquared;
            RenderSettings.fogDensity = 0.012f;
            RenderSettings.fogColor = new Color(0.50f, 0.55f, 0.62f);
            RenderSettings.ambientLight = new Color(0.42f, 0.45f, 0.52f);
        }
        else if (mistOrFog)
        {
            RenderSettings.fog = true;
            RenderSettings.fogMode = FogMode.ExponentialSquared;
            RenderSettings.fogDensity = 0.020f;
            RenderSettings.fogColor = new Color(0.75f, 0.78f, 0.82f);
            RenderSettings.ambientLight = new Color(0.55f, 0.58f, 0.62f);
        }
        else
        {
            RenderSettings.fog = true;
            RenderSettings.fogMode = FogMode.ExponentialSquared;
            RenderSettings.fogDensity = Mathf.Clamp(data.main.humidity * 0.0001f, 0.002f, 0.01f);
            RenderSettings.fogColor = new Color(0.68f, 0.72f, 0.78f);
        }

        Debug.Log("Weather updated for " + actualCity + ": " + condition + ", " + data.main.temp.ToString("F1") + " °C");
    }

    void ShowMessage(string message)
    {
        if (weatherPanel != null)
            weatherPanel.SetActive(true);

        if (weatherText != null)
        {
            weatherText.gameObject.SetActive(true);
            weatherText.text = message;
        }
    }

    void OnDestroy()
    {
        if (cityInput != null)
        {
            cityInput.onSubmit.RemoveListener(OnInputSubmit);
            cityInput.onEndEdit.RemoveListener(OnInputEndEdit);
        }

        if (searchButton != null)
            searchButton.onClick.RemoveListener(SearchCity);

        if (requestCoroutine != null)
            StopCoroutine(requestCoroutine);

        if (refreshCoroutine != null)
            StopCoroutine(refreshCoroutine);
    }
}